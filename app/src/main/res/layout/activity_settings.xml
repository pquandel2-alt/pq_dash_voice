<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Dashboard ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashboard-URL"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri" />

        <!-- ── Wyoming-Satellit ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Satellit-Port"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Satellit-Name"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Wake Word, Sprache-zu-Text, Conversation Agent und Sprachausgabe werden in Home Assistant beim Assist-Satelliten konfiguriert. Auf dem Tablet laufen keine lokalen Sprachmodelle mehr."
            android:textColor="#88000000"
            android:textSize="12sp" />

        <!-- ── Screensaver ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:background="#33000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Screensaver"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Screensaver starten nach" />
        <Spinner
            android:id="@+id/screensaverDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="HA Long-Lived Access Token (für Sensordaten)" />
        <EditText
            android:id="@+id/haToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
            android:inputType="textVisiblePassword"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sensor-IDs (kommasepariert, max. 3)" />
        <EditText
            android:id="@+id/screensaverSensors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sensor.aussentemperatur,weather.home"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Brain-Graph als Screensaver (URL leer = Uhr)" />
        <EditText
            android:id="@+id/screensaverBrainUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.178.101:8099/?kiosk"
            android:inputType="textUri"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Brain-Graph Zoom-Abstand (leer = Standard 2200)" />
        <EditText
            android:id="@+id/screensaverZoomDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="2200"
            android:inputType="number"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Uhr-Zeitfenster statt Graph (HH:mm, leer = kein Zeitfenster)" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/screensaverClockFrom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="von 22:00"
                android:inputType="datetime"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/screensaverClockTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="bis 06:00"
                android:inputType="datetime"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="HA-Entität zum Erzwingen (optional, überstimmt Zeitfenster): Zustand &quot;on&quot; = Uhr, sonst = Graph" />
        <EditText
            android:id="@+id/screensaverClockEntity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="input_boolean.tablet_uhr_erzwingen"
            android:inputType="text"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/screensaverGestures"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Gestensteuerung im Brain-Graph (Frontkamera, dreht/zoomt per Handbewegung)" />

        <!-- ── Klingel ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:background="#33000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Klingel / Türkamera"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="HA-Entität (Trigger)" />
        <EditText
            android:id="@+id/doorbellEntity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="input_boolean.klingel_kamera"
            android:inputType="text"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kamera-URL (Lovelace-Ansicht mit Kamera-Karte)" />
        <EditText
            android:id="@+id/doorbellCameraUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://ha.quandel-home.cc/lovelace/klingel"
            android:inputType="textUri"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Auto-Dismiss nach (Sekunden)" />
        <EditText
            android:id="@+id/doorbellAutoDismissSec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="30"
            android:inputType="number"
            android:textSize="12sp" />

        <!-- ── Audio ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:background="#33000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ttsVolumeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="TTS-Lautstärke: 80%" />
        <SeekBar
            android:id="@+id/ttsVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="80" />

        <!-- Far-field: Software-Mic-Gain (Ersatz für fehlendes Hardware-AGC) -->
        <TextView
            android:id="@+id/micGainLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mikrofon-Verstärkung: 1.0×" />
        <SeekBar
            android:id="@+id/micGain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="500"
            android:progress="0" />

        <CheckBox
            android:id="@+id/noiseSuppression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Rauschunterdrückung (für Far-field ggf. abschalten)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Animations-Stil (nach Speichern + Neustart aktiv)" />
        <Spinner
            android:id="@+id/animationStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- ── KI-Partikel-Screensaver ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:background="#33000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KI-Partikel-Screensaver"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/particleEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Partikel-Screensaver aktiv (statt Brain-Graph/Uhr)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Partikel-Qualität" />
        <Spinner
            android:id="@+id/particleQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <CheckBox
            android:id="@+id/particleAssemblyAnim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Zusammensetz-Animation beim Start zeigen" />

        <TextView
            android:id="@+id/particleSpeedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Animationsgeschwindigkeit: 1.0×" />
        <SeekBar
            android:id="@+id/particleSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="150"
            android:progress="50" />

        <CheckBox
            android:id="@+id/particleShowTranscript"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Transkript im Screensaver anzeigen" />

        <CheckBox
            android:id="@+id/particleShowResponse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Antwort im Screensaver anzeigen" />

        <!-- ── Standard-Launcher ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:background="#33000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kiosk-Modus"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="DashVoice als Standard-Startbildschirm festlegen. Nach dem Reboot startet dann direkt das Dashboard statt des EMUI-Launchers." />

        <Button
            android:id="@+id/setDefaultLauncher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Standard-Launcher einstellen…" />

        <!-- ── Speichern ── -->
        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Speichern" />
    </LinearLayout>
</ScrollView>
