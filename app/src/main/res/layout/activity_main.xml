<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HA connection status indicator -->
    <View
        android:id="@+id/statusDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/status_dot" />

    <ImageButton
        android:id="@+id/micButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@android:drawable/btn_default"
        android:src="@android:drawable/ic_btn_speak_now"
        android:contentDescription="@string/app_name" />

    <!-- Centered voice animation — shown on wake word, over everything -->
    <cc.quandel.dashvoice.VoiceAnimationView
        android:id="@+id/voiceAnimation"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Voice overlay: shown while wake/listening/speaking is active -->
    <LinearLayout
        android:id="@+id/voiceOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D0000000"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/voiceMicIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_btn_speak_now" />

            <TextView
                android:id="@+id/voiceStateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textColor="#FF4CAF50"
                android:textSize="14sp"
                android:text="Zuhören…" />
        </LinearLayout>

        <TextView
            android:id="@+id/voiceTranscriptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/voiceResponseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FF82B1FF"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/screensaver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFCCCCCC"
            android:textSize="96sp" />

        <TextView
            android:id="@+id/screensaverDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FF999999"
            android:textSize="22sp" />

        <LinearLayout
            android:id="@+id/sensorContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/sensor1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF999999"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sensor2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FF999999"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sensor3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FF999999"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#FF66FF66"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

    <Button
        android:id="@+id/logToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:alpha="0.45"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="6dp"
        android:text="LOG"
        android:textSize="10sp" />
</FrameLayout>
